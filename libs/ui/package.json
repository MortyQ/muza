{
  "name": "@muzakit/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "build:lib": "vite build",
    "build:watch": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:visual": "vitest run --project browser",
    "test:visual:update": "bash scripts/visual-docker.sh --update",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:tokens": "vitest run --project browser tests/visual/tokens",
    "test:visual:docker": "bash scripts/visual-docker.sh"
  },
  "peerDependencies": {
    "vue": "^3.5.34",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@iconify-json/lucide": "^1.2.122",
    "@iconify-json/mdi": "^1.2.3",
    "@muzakit/config": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/luxon": "^3.4.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "sass-embedded": "^1.97.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "4.1.10",
    "vitest-browser-vue": "2.1.0",
    "vue": "^3.5.34",
    "vue-router": "^5.2.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@muzakit/utils": "workspace:*",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vuepic/vue-datepicker": "^12.0.0",
    "@vueuse/core": "^14.2.1",
    "keyv-browser": "^0.1.1",
    "luxon": "^3.5.0",
    "vue-multiselect": "^3.0.0",
    "vue-sonner": "^2.0.9"
  }
}
